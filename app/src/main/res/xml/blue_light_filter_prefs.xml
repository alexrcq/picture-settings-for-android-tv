<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/blue_light_filter">
    <ListPreference
        app:defaultValue="0"
        app:entries="@array/blue_light_filter_mode_entries"
        app:entryValues="@array/blue_light_filter_mode_values"
        app:key="blue_light_filter_mode"
        app:title="@string/blue_light_filter_mode_title"
        app:useSimpleSummaryProvider="true" />
    <com.alexrcq.tvpicturesettings.ui.preference.LeanbackSeekBarPreference
        android:max="2900"
        app:defaultValue="@integer/def_blue_light_filter_temperature"
        app:key="blue_light_filter_temperature"
        app:min="1000"
        app:seekBarIncrement="50"
        app:showSeekBarValue="true"
        app:title="@string/blue_light_filter_temperature" />
    <com.alexrcq.tvpicturesettings.ui.preference.LeanbackSeekBarPreference
        android:max="50"
        app:defaultValue="@integer/def_blue_light_filter_power"
        app:key="blue_light_filter_power"
        app:seekBarIncrement="1"
        app:showSeekBarValue="true"
        app:title="@string/intensity" />
    <Preference
        app:key="reset_values"
        app:title="@string/reset" />
</PreferenceScreen>