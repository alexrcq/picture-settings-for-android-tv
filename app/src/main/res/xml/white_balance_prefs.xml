<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:title="@string/white_balance">
    <com.alexrcq.tvpicturesettings.ui.preference.GlobalSeekBarPreference
        android:max="2047"
        app:key="picture_red_gain"
        app:title="@string/red" />
    <com.alexrcq.tvpicturesettings.ui.preference.GlobalSeekBarPreference
        android:max="2047"
        app:key="picture_green_gain"
        app:title="@string/green" />
    <com.alexrcq.tvpicturesettings.ui.preference.GlobalSeekBarPreference
        android:max="2047"
        app:key="picture_blue_gain"
        app:title="@string/blue" />
    <SwitchPreference
        app:defaultValue="@bool/def_white_balance_locked"
        app:key="fix_wb_values"
        app:summary="@string/lock_values_summary"
        app:title="@string/lock_values" />
    <Preference
        app:key="reset_values"
        app:title="@string/reset_values" />
</PreferenceScreen>