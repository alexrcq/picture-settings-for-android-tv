<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    app:title="@string/advanced_settings">
    <Preference
        app:key="blue_light_filter"
        app:title="@string/blue_light_filter" />
    <SwitchPreference
        app:defaultValue="@bool/def_disable_dark_mode_on_power_on"
        app:key="is_enable_day_mode_after_screen_on_enabled"
        app:title="@string/disable_dark_mode_on_power_on" />
    <SwitchPreference
        app:key="step_by_step_dark_mode_enabled"
        app:title="@string/step_by_step_dark_mode" />
    <SwitchPreference
        app:defaultValue="@bool/def_show_mode_changed"
        app:key="show_mode_changed"
        app:title="@string/show_mode_changed" />
</androidx.preference.PreferenceScreen>